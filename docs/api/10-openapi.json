{
  "openapi": "3.1.0",
  "info": {
    "title": "DevicePulse — API REST",
    "version": "0.1.0",
    "summary": "Contrato proposto do MVP de monitoramento de dispositivos fictícios",
    "description": "DP-010 • contrato em revisão. Dados exclusivamente fictícios. O MVP é local e não possui autenticação de operadores; não publicar operações de escrita sem controles de segurança. O banco de referência é PostgreSQL, com estados e alertas de DP-004/DP-009. Paths relativos ao server URL.",
    "license": {
      "name": "Documentação interna do projeto DevicePulse"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Ambiente local fictício; porta proposta, será configurável na implementação."
    }
  ],
  "tags": [
    {
      "name": "Dispositivos",
      "description": "Cadastro, listagem, filtros e detalhamento."
    },
    {
      "name": "Eventos",
      "description": "Recebimento idempotente e histórico de medições."
    },
    {
      "name": "Alertas",
      "description": "Consulta, reconhecimento e resolução somente automática por regras internas."
    },
    {
      "name": "Dashboard",
      "description": "Indicadores agregados do sistema."
    }
  ],
  "paths": {
    "/devices": {
      "post": {
        "tags": [
          "Dispositivos"
        ],
        "operationId": "createDevice",
        "summary": "Cadastrar dispositivo fictício",
        "description": "Recebe code e name. O backend normaliza code para maiúsculas, atribui UUID e inicia em SEM_DADOS. Não cria evento nem alerta no cadastro.",
        "requestBody": {
          "required": true,
          "description": "Dados cadastrais fictícios.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDeviceRequest"
              },
              "examples": {
                "example": {
                  "value": {
                    "code": "SENSOR_001",
                    "name": "Sensor de demonstração 01"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dispositivo criado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "data": {
                        "id": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "code": "SENSOR_001",
                        "name": "Sensor de demonstração 01",
                        "connectivityStatus": "SEM_DADOS",
                        "batteryLevel": null,
                        "batteryStatus": "SEM_DADOS",
                        "lastEventAt": null,
                        "batteryReadingIsStale": false,
                        "createdAt": "2026-10-26T17:00:00Z",
                        "updatedAt": "2026-10-26T17:00:00Z"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Caminho da representação criada.",
                "schema": {
                  "type": "string"
                },
                "example": "/api/v1/devices/383f7ac3-55f4-4891-8fa6-88253ce7b42c"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "get": {
        "tags": [
          "Dispositivos"
        ],
        "operationId": "listDevices",
        "summary": "Listar, buscar e filtrar dispositivos",
        "description": "Pesquisa q sem distinção de maiúsculas em code/name e filtra pelo estado técnico de comunicação. Ordenação estável por code ASC e id ASC.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Busca parcial por nome ou código.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "example": "SENSOR"
          },
          {
            "name": "connectivityStatus",
            "in": "query",
            "required": false,
            "description": "Filtrar pelo estado de comunicação.",
            "schema": {
              "type": "string",
              "enum": [
                "SEM_DADOS",
                "ONLINE",
                "OFFLINE"
              ]
            },
            "example": "ONLINE"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada, inclusive vazia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceListResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "data": [
                        {
                          "id": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                          "code": "SENSOR_001",
                          "name": "Sensor de demonstração 01",
                          "connectivityStatus": "ONLINE",
                          "batteryLevel": 15,
                          "batteryStatus": "BAIXA",
                          "lastEventAt": "2026-10-26T17:00:00Z",
                          "batteryReadingIsStale": false,
                          "createdAt": "2026-10-26T17:00:00Z",
                          "updatedAt": "2026-10-26T17:00:00Z"
                        }
                      ],
                      "meta": {
                        "page": 1,
                        "pageSize": 20,
                        "totalItems": 1,
                        "totalPages": 1
                      }
                    }
                  },
                  "empty": {
                    "summary": "Nenhum dispositivo corresponde ao filtro",
                    "value": {
                      "data": [],
                      "meta": {
                        "page": 1,
                        "pageSize": 20,
                        "totalItems": 0,
                        "totalPages": 0
                      }
                    }
                  },
                  "offline": {
                    "summary": "Dispositivo sem comunicação, mantendo bateria conhecida",
                    "value": {
                      "data": [
                        {
                          "id": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                          "code": "SENSOR_001",
                          "name": "Sensor de demonstração 01",
                          "connectivityStatus": "OFFLINE",
                          "batteryLevel": 15,
                          "batteryStatus": "BAIXA",
                          "lastEventAt": "2026-10-26T17:00:00Z",
                          "batteryReadingIsStale": true,
                          "createdAt": "2026-10-26T17:00:00Z",
                          "updatedAt": "2026-10-26T17:00:00Z"
                        }
                      ],
                      "meta": {
                        "page": 1,
                        "pageSize": 20,
                        "totalItems": 1,
                        "totalPages": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/devices/{deviceId}": {
      "get": {
        "tags": [
          "Dispositivos"
        ],
        "operationId": "getDevice",
        "summary": "Detalhar dispositivo",
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Dados e estado mais recente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "data": {
                        "id": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "code": "SENSOR_001",
                        "name": "Sensor de demonstração 01",
                        "connectivityStatus": "ONLINE",
                        "batteryLevel": 15,
                        "batteryStatus": "BAIXA",
                        "lastEventAt": "2026-10-26T17:00:00Z",
                        "batteryReadingIsStale": false,
                        "createdAt": "2026-10-26T17:00:00Z",
                        "updatedAt": "2026-10-26T17:00:00Z"
                      }
                    }
                  },
                  "noData": {
                    "summary": "Dispositivo cadastrado antes da primeira medição",
                    "value": {
                      "data": {
                        "id": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "code": "SENSOR_001",
                        "name": "Sensor de demonstração 01",
                        "connectivityStatus": "SEM_DADOS",
                        "batteryLevel": null,
                        "batteryStatus": "SEM_DADOS",
                        "lastEventAt": null,
                        "batteryReadingIsStale": false,
                        "createdAt": "2026-10-26T17:00:00Z",
                        "updatedAt": "2026-10-26T17:00:00Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/devices/{deviceId}/events": {
      "get": {
        "tags": [
          "Eventos"
        ],
        "operationId": "listDeviceEvents",
        "summary": "Consultar histórico de medições de um dispositivo",
        "description": "Eventos em occurredAt DESC, eventId DESC, incluindo eventos aceitos fora de ordem. Ordenação determinística e paginação.",
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Histórico paginado do dispositivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventListResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "data": [
                        {
                          "eventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                          "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                          "occurredAt": "2026-10-26T17:00:00Z",
                          "receivedAt": "2026-10-26T17:00:01Z",
                          "batteryLevel": 15
                        }
                      ],
                      "meta": {
                        "page": 1,
                        "pageSize": 20,
                        "totalItems": 1,
                        "totalPages": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/events": {
      "post": {
        "tags": [
          "Eventos"
        ],
        "operationId": "ingestEvent",
        "summary": "Receber medição fictícia",
        "description": "Validar campos, UUIDs e occurredAt com fuso explícito não futuro. Verificar deviceId existente e eventId global. Em operação transacional, registrar evento; APPLIED apenas se ocorrido depois do último evento aplicado, HISTORY_ONLY se igual/anterior. Reenvio idêntico retorna 200 ALREADY_PROCESSED sem atualizar receivedAt ou estado. Reenvio conflitante retorna 409.",
        "requestBody": {
          "required": true,
          "description": "Evento gerado pelo simulador. A identidade do evento permanece em reenvios.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              },
              "examples": {
                "example": {
                  "value": {
                    "eventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                    "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                    "occurredAt": "2026-10-26T17:00:00Z",
                    "batteryLevel": 15
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reenvio idêntico: operação idempotente, sem nova escrita.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventIngestResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "data": {
                        "eventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                        "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "occurredAt": "2026-10-26T17:00:00Z",
                        "receivedAt": "2026-10-26T17:00:01Z",
                        "batteryLevel": 15
                      },
                      "processingResult": "ALREADY_PROCESSED"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Evento novo persistido: APPLIED ou HISTORY_ONLY.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventIngestResponse"
                },
                "examples": {
                  "applied": {
                    "value": {
                      "data": {
                        "eventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                        "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "occurredAt": "2026-10-26T17:00:00Z",
                        "receivedAt": "2026-10-26T17:00:01Z",
                        "batteryLevel": 15
                      },
                      "processingResult": "APPLIED"
                    }
                  },
                  "historyOnly": {
                    "value": {
                      "data": {
                        "eventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                        "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "occurredAt": "2026-10-26T16:45:00Z",
                        "receivedAt": "2026-10-26T17:00:01Z",
                        "batteryLevel": 15
                      },
                      "processingResult": "HISTORY_ONLY"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "tags": [
          "Alertas"
        ],
        "operationId": "listAlerts",
        "summary": "Listar e filtrar ocorrências",
        "description": "status é derivado de resolvedAt e acknowledged de acknowledgedAt; ambos são filtros lógicos, não colunas persistidas. Ordenação openedAt DESC, id DESC.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filtro pelo ciclo da ocorrência.",
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "RESOLVED"
              ]
            },
            "example": "OPEN"
          },
          {
            "name": "acknowledged",
            "in": "query",
            "required": false,
            "description": "Filtra ciência do operador de forma independente da resolução.",
            "schema": {
              "type": "boolean"
            },
            "example": false
          },
          {
            "name": "alertType",
            "in": "query",
            "required": false,
            "description": "Tipo de falha.",
            "schema": {
              "type": "string",
              "enum": [
                "LOW_BATTERY",
                "NO_COMMUNICATION"
              ]
            },
            "example": "LOW_BATTERY"
          },
          {
            "name": "deviceId",
            "in": "query",
            "required": false,
            "description": "UUID do dispositivo; validação de formato obrigatória.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "383f7ac3-55f4-4891-8fa6-88253ce7b42c"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada, inclusive vazia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "data": [
                        {
                          "id": "a15bef2e-41e2-44e0-ac70-d334f3ef7a3c",
                          "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                          "alertType": "LOW_BATTERY",
                          "sourceEventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                          "openedAt": "2026-10-26T17:00:01Z",
                          "acknowledgedAt": null,
                          "resolvedAt": null,
                          "status": "OPEN",
                          "acknowledged": false
                        }
                      ],
                      "meta": {
                        "page": 1,
                        "pageSize": 20,
                        "totalItems": 1,
                        "totalPages": 1
                      }
                    }
                  },
                  "resolvedWithoutAck": {
                    "summary": "Alerta resolvido automaticamente sem reconhecimento",
                    "value": {
                      "data": [
                        {
                          "id": "a15bef2e-41e2-44e0-ac70-d334f3ef7a3c",
                          "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                          "alertType": "LOW_BATTERY",
                          "sourceEventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                          "openedAt": "2026-10-26T17:00:01Z",
                          "acknowledgedAt": null,
                          "resolvedAt": "2026-10-26T17:05:00Z",
                          "status": "RESOLVED",
                          "acknowledged": false
                        }
                      ],
                      "meta": {
                        "page": 1,
                        "pageSize": 20,
                        "totalItems": 1,
                        "totalPages": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/alerts/{alertId}": {
      "get": {
        "tags": [
          "Alertas"
        ],
        "operationId": "getAlert",
        "summary": "Consultar detalhe de ocorrência",
        "parameters": [
          {
            "$ref": "#/components/parameters/AlertId"
          }
        ],
        "responses": {
          "200": {
            "description": "Ocorrência com reconhecimento e resolução independentes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "data": {
                        "id": "a15bef2e-41e2-44e0-ac70-d334f3ef7a3c",
                        "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "alertType": "LOW_BATTERY",
                        "sourceEventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                        "openedAt": "2026-10-26T17:00:01Z",
                        "acknowledgedAt": null,
                        "resolvedAt": null,
                        "status": "OPEN",
                        "acknowledged": false
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/alerts/{alertId}/acknowledge": {
      "post": {
        "tags": [
          "Alertas"
        ],
        "operationId": "acknowledgeAlert",
        "summary": "Reconhecer alerta ainda aberto",
        "description": "Não exige corpo. Alerta inexistente: 404; já resolvido: 409, mesmo que tenha sido reconhecido antes; aberto e já reconhecido: 200 idempotente sem alterar timestamp; aberto e não reconhecido: gravar acknowledgedAt uma vez, com verificação atômica resolved_at IS NULL. Não resolve ocorrência nem modifica estado do dispositivo. MVP local sem identidade autenticada de operador.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AlertId"
          }
        ],
        "responses": {
          "200": {
            "description": "Reconhecimento efetuado ou repetido de modo idempotente enquanto aberto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                },
                "examples": {
                  "acknowledged": {
                    "value": {
                      "data": {
                        "id": "a15bef2e-41e2-44e0-ac70-d334f3ef7a3c",
                        "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "alertType": "LOW_BATTERY",
                        "sourceEventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                        "openedAt": "2026-10-26T17:00:01Z",
                        "acknowledgedAt": "2026-10-26T17:01:00Z",
                        "resolvedAt": null,
                        "status": "OPEN",
                        "acknowledged": true
                      }
                    }
                  },
                  "alreadyAcknowledged": {
                    "value": {
                      "data": {
                        "id": "a15bef2e-41e2-44e0-ac70-d334f3ef7a3c",
                        "deviceId": "383f7ac3-55f4-4891-8fa6-88253ce7b42c",
                        "alertType": "LOW_BATTERY",
                        "sourceEventId": "7a4c4e36-88c9-4059-aa65-9b1e0b88b4be",
                        "openedAt": "2026-10-26T17:00:01Z",
                        "acknowledgedAt": "2026-10-26T17:01:00Z",
                        "resolvedAt": null,
                        "status": "OPEN",
                        "acknowledged": true
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "operationId": "getDashboardSummary",
        "summary": "Consultar indicadores operacionais",
        "description": "Sem filtros na versão inicial. totalDevices = onlineDevices + offlineDevices + noDataDevices. openAlerts = openAcknowledgedAlerts + openUnacknowledgedAlerts. Os valores refletem o último estado persistido e podem estar sujeitos ao intervalo de atualização do frontend.",
        "responses": {
          "200": {
            "description": "Contagens atuais do backend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "data": {
                        "totalDevices": 10,
                        "onlineDevices": 7,
                        "offlineDevices": 2,
                        "noDataDevices": 1,
                        "openAlerts": 3,
                        "openAcknowledgedAlerts": 1,
                        "openUnacknowledgedAlerts": 2
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "DeviceId": {
        "name": "deviceId",
        "in": "path",
        "required": true,
        "description": "UUID técnico de devices.id",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "383f7ac3-55f4-4891-8fa6-88253ce7b42c"
      },
      "AlertId": {
        "name": "alertId",
        "in": "path",
        "required": true,
        "description": "UUID da ocorrência",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "a15bef2e-41e2-44e0-ac70-d334f3ef7a3c"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Página iniciada em 1.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "example": 1
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "description": "Quantidade por página (máximo 100).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "example": 20
      }
    },
    "schemas": {
      "CreateDeviceRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Normalizado em caixa alta no backend. Código exclusivo do dispositivo fictício.",
            "example": "SENSOR_001"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Deve conter caracteres não brancos; trim aplicado.",
            "example": "Sensor de demonstração 01"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "connectivityStatus": {
            "type": "string",
            "enum": [
              "SEM_DADOS",
              "ONLINE",
              "OFFLINE"
            ]
          },
          "batteryLevel": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Última medição válida, null antes da primeira comunicação."
          },
          "batteryStatus": {
            "type": "string",
            "enum": [
              "SEM_DADOS",
              "NORMAL",
              "BAIXA"
            ],
            "description": "Derivado de batteryLevel, não coluna independente."
          },
          "lastEventAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Instante RFC 3339 em UTC ou null."
          },
          "batteryReadingIsStale": {
            "type": "boolean",
            "description": "true se conectividade OFFLINE e existe última bateria conhecida."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora RFC 3339; respostas normalizadas em UTC."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora RFC 3339; respostas normalizadas em UTC."
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "connectivityStatus",
          "batteryLevel",
          "batteryStatus",
          "lastEventAt",
          "batteryReadingIsStale",
          "createdAt",
          "updatedAt"
        ]
      },
      "DeviceResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Device"
          }
        },
        "required": [
          "data"
        ]
      },
      "DeviceListResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ]
      },
      "CreateEventRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID global: o mesmo eventId com conteúdo idêntico é idempotente."
          },
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$",
            "description": "Data/hora de ocorrência com fuso explícito. Não pode ser futura."
          },
          "batteryLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Percentual simulado, inteiro."
          }
        },
        "required": [
          "eventId",
          "deviceId",
          "occurredAt",
          "batteryLevel"
        ]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora RFC 3339; respostas normalizadas em UTC."
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora RFC 3339; respostas normalizadas em UTC."
          },
          "batteryLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "eventId",
          "deviceId",
          "occurredAt",
          "receivedAt",
          "batteryLevel"
        ]
      },
      "EventIngestResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Event"
          },
          "processingResult": {
            "type": "string",
            "enum": [
              "APPLIED",
              "HISTORY_ONLY",
              "ALREADY_PROCESSED"
            ],
            "description": "APPLIED: alterou estado/avaliou alertas; HISTORY_ONLY: chegou fora de ordem; ALREADY_PROCESSED: idempotente e nenhuma gravação."
          }
        },
        "required": [
          "data",
          "processingResult"
        ]
      },
      "EventListResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "Alert": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "alertType": {
            "type": "string",
            "enum": [
              "LOW_BATTERY",
              "NO_COMMUNICATION"
            ]
          },
          "sourceEventId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Obrigatório para LOW_BATTERY; null para NO_COMMUNICATION."
          },
          "openedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora RFC 3339; respostas normalizadas em UTC."
          },
          "acknowledgedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Instante RFC 3339 em UTC ou null."
          },
          "resolvedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Instante RFC 3339 em UTC ou null."
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESOLVED"
            ],
            "readOnly": true,
            "description": "Derivado de resolvedAt; não persistido como coluna."
          },
          "acknowledged": {
            "type": "boolean",
            "readOnly": true,
            "description": "Derivado de acknowledgedAt; reconhecer não resolve a condição."
          }
        },
        "required": [
          "id",
          "deviceId",
          "alertType",
          "sourceEventId",
          "openedAt",
          "acknowledgedAt",
          "resolvedAt",
          "status",
          "acknowledged"
        ]
      },
      "AlertResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Alert"
          }
        },
        "required": [
          "data"
        ]
      },
      "AlertListResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "DashboardSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "totalDevices": {
            "type": "integer",
            "minimum": 0
          },
          "onlineDevices": {
            "type": "integer",
            "minimum": 0
          },
          "offlineDevices": {
            "type": "integer",
            "minimum": 0
          },
          "noDataDevices": {
            "type": "integer",
            "minimum": 0
          },
          "openAlerts": {
            "type": "integer",
            "minimum": 0
          },
          "openAcknowledgedAlerts": {
            "type": "integer",
            "minimum": 0
          },
          "openUnacknowledgedAlerts": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "totalDevices",
          "onlineDevices",
          "offlineDevices",
          "noDataDevices",
          "openAlerts",
          "openAcknowledgedAlerts",
          "openUnacknowledgedAlerts"
        ]
      },
      "DashboardResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/DashboardSummary"
          }
        },
        "required": [
          "data"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "description": "Caminho JSON ou parâmetro associado ao erro; por exemplo batteryLevel."
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "description": "Código de erro estável, em caixa alta."
              },
              "message": {
                "type": "string",
                "description": "Mensagem simples em português para exibição."
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              },
              "requestId": {
                "type": "string",
                "description": "Identificador opcional para rastreamento de logs."
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validação, identificador ou parâmetro de consulta inválido (400).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalidPayload": {
                "value": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Os dados informados são inválidos.",
                    "details": []
                  }
                }
              },
              "invalidBattery": {
                "value": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Revise os campos enviados.",
                    "details": [
                      {
                        "field": "batteryLevel",
                        "message": "Revise os campos enviados."
                      }
                    ]
                  }
                }
              },
              "futureDate": {
                "value": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "A data da ocorrência não pode estar no futuro.",
                    "details": [
                      {
                        "field": "occurredAt",
                        "message": "A data da ocorrência não pode estar no futuro."
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso não encontrado (404).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "unknownDevice": {
                "value": {
                  "error": {
                    "code": "DEVICE_NOT_FOUND",
                    "message": "Dispositivo não encontrado.",
                    "details": []
                  }
                }
              },
              "unknownAlert": {
                "value": {
                  "error": {
                    "code": "ALERT_NOT_FOUND",
                    "message": "Alerta não encontrado.",
                    "details": []
                  }
                }
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflito com identidade, estado ou histórico já registrado (409).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "duplicateDevice": {
                "value": {
                  "error": {
                    "code": "DEVICE_CODE_CONFLICT",
                    "message": "Já existe um dispositivo com esse código.",
                    "details": []
                  }
                }
              },
              "eventConflict": {
                "value": {
                  "error": {
                    "code": "EVENT_ID_CONFLICT",
                    "message": "O identificador do evento já existe com conteúdo diferente.",
                    "details": []
                  }
                }
              },
              "resolvedAlert": {
                "value": {
                  "error": {
                    "code": "ALERT_ALREADY_RESOLVED",
                    "message": "Não é possível reconhecer um alerta resolvido.",
                    "details": []
                  }
                }
              }
            }
          }
        }
      },
      "Internal": {
        "description": "Falha inesperada (500). Operação não confirmada como sucesso.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "unexpected": {
                "value": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Não foi possível concluir a operação.",
                    "details": []
                  }
                }
              }
            }
          }
        }
      },
      "Unavailable": {
        "description": "Banco ou serviço temporariamente indisponível (503). Resultado não confirmado.",
        "headers": {
          "Retry-After": {
            "description": "Pode indicar o intervalo de espera sugerido, em segundos.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "databaseUnavailable": {
                "value": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "Serviço indisponível. Tente novamente mais tarde.",
                    "details": []
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
