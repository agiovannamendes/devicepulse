<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_reconhecimento-alertas" targetNamespace="https://github.com/agiovannamendes/devicepulse/bpmn" exporter="DevicePulse" exporterVersion="1.0">
  <bpmn:message id="Message_reconhecimento-alertas" name="Solicitação ao DevicePulse"/>
  <bpmn:error id="Error_reconhecimento-alertas" name="Falha de persistência" errorCode="DB_WRITE_FAILURE"/>
  <bpmn:collaboration id="Collaboration_reconhecimento-alertas"><bpmn:participant id="Actor_reconhecimento-alertas" name="Operador"/><bpmn:participant id="DevicePulse_reconhecimento-alertas" name="DevicePulse — processamento" processRef="Process_reconhecimento-alertas"/><bpmn:messageFlow id="MessageFlow_Request_reconhecimento-alertas" sourceRef="Actor_reconhecimento-alertas" targetRef="Start_Recognize"/><bpmn:messageFlow id="MessageFlow_Return_1" sourceRef="Task_Resp404" targetRef="Actor_reconhecimento-alertas"/><bpmn:messageFlow id="MessageFlow_Return_2" sourceRef="Task_Resp409" targetRef="Actor_reconhecimento-alertas"/><bpmn:messageFlow id="MessageFlow_Return_3" sourceRef="Task_RespIdempotente" targetRef="Actor_reconhecimento-alertas"/><bpmn:messageFlow id="MessageFlow_Return_4" sourceRef="Task_RespSucesso" targetRef="Actor_reconhecimento-alertas"/><bpmn:messageFlow id="MessageFlow_Return_5" sourceRef="Task_RespFalha" targetRef="Actor_reconhecimento-alertas"/></bpmn:collaboration>
  <bpmn:process id="Process_reconhecimento-alertas" name="DP-006 | Reconhecimento de alerta pelo operador" isExecutable="false">
    <bpmn:startEvent id="Start_Recognize" name="Solicitação de reconhecimento"><bpmn:outgoing>Flow_StartRecognize_TaskBuscarAlerta</bpmn:outgoing><bpmn:messageEventDefinition id="MessageDef_Start_Recognize" messageRef="Message_reconhecimento-alertas"/></bpmn:startEvent>
    <bpmn:task id="Task_BuscarAlerta" name="Consultar ocorrência"><bpmn:incoming>Flow_StartRecognize_TaskBuscarAlerta</bpmn:incoming><bpmn:outgoing>Flow_TaskBuscarAlerta_GatewayEncontrou</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Encontrou" name="Alerta existe?"><bpmn:incoming>Flow_TaskBuscarAlerta_GatewayEncontrou</bpmn:incoming><bpmn:outgoing>Flow_GatewayEncontrou_TaskResp404</bpmn:outgoing><bpmn:outgoing>Flow_GatewayEncontrou_TaskChecarAberto</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Resp404" name="Responder: alerta inexistente (404)"><bpmn:incoming>Flow_GatewayEncontrou_TaskResp404</bpmn:incoming><bpmn:outgoing>Flow_TaskResp404_End404</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_404" name="Não encontrado"><bpmn:incoming>Flow_TaskResp404_End404</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_ChecarAberto" name="Verificar data de resolução"><bpmn:incoming>Flow_GatewayEncontrou_TaskChecarAberto</bpmn:incoming><bpmn:outgoing>Flow_TaskChecarAberto_GatewayAberto</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Aberto" name="Ainda aberto?"><bpmn:incoming>Flow_TaskChecarAberto_GatewayAberto</bpmn:incoming><bpmn:outgoing>Flow_GatewayAberto_TaskResp409</bpmn:outgoing><bpmn:outgoing>Flow_GatewayAberto_TaskVerificarReconhecido</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Resp409" name="Responder: já resolvido (409)"><bpmn:incoming>Flow_GatewayAberto_TaskResp409</bpmn:incoming><bpmn:outgoing>Flow_TaskResp409_End409</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_409" name="Reconhecimento negado"><bpmn:incoming>Flow_TaskResp409_End409</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_VerificarReconhecido" name="Verificar se já foi reconhecido"><bpmn:incoming>Flow_GatewayAberto_TaskVerificarReconhecido</bpmn:incoming><bpmn:outgoing>Flow_TaskVerificarReconhecido_GatewayJaReconhecido</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_JaReconhecido" name="Já reconhecido?"><bpmn:incoming>Flow_TaskVerificarReconhecido_GatewayJaReconhecido</bpmn:incoming><bpmn:outgoing>Flow_GatewayJaReconhecido_TaskRespIdempotente</bpmn:outgoing><bpmn:outgoing>Flow_GatewayJaReconhecido_TaskGravarAck</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RespIdempotente" name="Responder: já reconhecido (200)"><bpmn:incoming>Flow_GatewayJaReconhecido_TaskRespIdempotente</bpmn:incoming><bpmn:outgoing>Flow_TaskRespIdempotente_End200</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_200" name="Sem duplicar ação"><bpmn:incoming>Flow_TaskRespIdempotente_End200</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_GravarAck" name="Registrar acknowledgedAt"><bpmn:incoming>Flow_GatewayJaReconhecido_TaskGravarAck</bpmn:incoming><bpmn:outgoing>Flow_TaskGravarAck_TaskRespSucesso</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ErroAck" name="Falha na gravação" attachedToRef="Task_GravarAck" cancelActivity="true"><bpmn:outgoing>Flow_BoundaryErroAck_TaskRespFalha</bpmn:outgoing><bpmn:errorEventDefinition id="ErrorDef_Boundary_ErroAck" errorRef="Error_reconhecimento-alertas"/></bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_RespSucesso" name="Responder: reconhecido (200)"><bpmn:incoming>Flow_TaskGravarAck_TaskRespSucesso</bpmn:incoming><bpmn:outgoing>Flow_TaskRespSucesso_EndSucesso</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_Sucesso" name="Reconhecido; falha pode continuar"><bpmn:incoming>Flow_TaskRespSucesso_EndSucesso</bpmn:incoming></bpmn:endEvent>
    <bpmn:sendTask id="Task_RespFalha" name="Responder: falha ao registrar (500)"><bpmn:incoming>Flow_DP007_DB_Task_VerificarReconhecido</bpmn:incoming><bpmn:incoming>Flow_DP007_DB_Task_ChecarAberto</bpmn:incoming><bpmn:incoming>Flow_DP007_DB_Task_BuscarAlerta</bpmn:incoming><bpmn:incoming>Flow_BoundaryErroAck_TaskRespFalha</bpmn:incoming><bpmn:outgoing>Flow_TaskRespFalha_EndFalha</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_Falha" name="Não confirmado"><bpmn:incoming>Flow_TaskRespFalha_EndFalha</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartRecognize_TaskBuscarAlerta" sourceRef="Start_Recognize" targetRef="Task_BuscarAlerta"/>
