      <bpmndi:BPMNEdge id="Edge_Flow_REC_13" bpmnElement="Flow_REC_13"><di:waypoint x="1357" y="395"/><di:waypoint x="1357" y="541"/><di:waypoint x="1420" y="541"/></bpmndi:BPMNEdge>
