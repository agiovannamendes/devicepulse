    <bpmn:exclusiveGateway id="Gateway_ExisteDispositivo" name="Existe dispositivo?"><bpmn:incoming>Flow_Ing_06</bpmn:incoming><bpmn:outgoing>Flow_Ing_07</bpmn:outgoing><bpmn:outgoing>Flow_Ing_09</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Resp404" name="Responder: não encontrado"><bpmn:incoming>Flow_Ing_07</bpmn:incoming><bpmn:outgoing>Flow_Ing_08</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_404" name="Rejeitado (404)"><bpmn:incoming>Flow_Ing_08</bpmn:incoming></bpmn:endEvent>
