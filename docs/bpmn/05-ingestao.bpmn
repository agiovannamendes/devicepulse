    <bpmn:exclusiveGateway id="Gateway_EventoValido" name="Evento válido?"><bpmn:incoming>Flow_Ing_02</bpmn:incoming><bpmn:outgoing>Flow_Ing_03</bpmn:outgoing><bpmn:outgoing>Flow_Ing_05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Resp400" name="Responder: evento inválido"><bpmn:incoming>Flow_Ing_03</bpmn:incoming><bpmn:outgoing>Flow_Ing_04</bpmn:outgoing></bpmn:sendTask>
