<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_avaliacao-alertas" targetNamespace="https://github.com/agiovannamendes/devicepulse/bpmn" exporter="DevicePulse" exporterVersion="1.0">
  <bpmn:message id="Message_avaliacao-alertas" name="Solicitação ao DevicePulse"/>
  <bpmn:error id="Error_avaliacao-alertas" name="Falha de persistência" errorCode="DB_WRITE_FAILURE"/>
  <bpmn:collaboration id="Collaboration_avaliacao-alertas"><bpmn:participant id="DevicePulse_avaliacao-alertas" name="DevicePulse — processamento" processRef="Process_avaliacao-alertas"/></bpmn:collaboration>
  <bpmn:process id="Process_avaliacao-alertas" name="DP-006 | Avaliação automática, abertura e resolução" isExecutable="false">
    <bpmn:startEvent id="Start_Evaluate" name="Avaliação iniciada"><bpmn:outgoing>Flow_StartEvaluate_TaskDeterminarTipo</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_DeterminarTipo" name="Determinar dispositivo, tipo e estado"><bpmn:incoming>Flow_StartEvaluate_TaskDeterminarTipo</bpmn:incoming><bpmn:outgoing>Flow_TaskDeterminarTipo_GatewayTemDados</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TemDados" name="Há dados válidos?"><bpmn:incoming>Flow_TaskDeterminarTipo_GatewayTemDados</bpmn:incoming><bpmn:outgoing>Flow_GatewayTemDados_TaskSemDados</bpmn:outgoing><bpmn:outgoing>Flow_GatewayTemDados_GatewayCondicao</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_SemDados" name="Manter SEM_DADOS sem abrir alerta"><bpmn:incoming>Flow_GatewayTemDados_TaskSemDados</bpmn:incoming><bpmn:outgoing>Flow_TaskSemDados_EndSemDados</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_SemDados" name="Sem ocorrência"><bpmn:incoming>Flow_TaskSemDados_EndSemDados</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Condicao" name="Condição de falha ativa?"><bpmn:incoming>Flow_GatewayTemDados_GatewayCondicao</bpmn:incoming><bpmn:outgoing>Flow_GatewayCondicao_TaskConsultarAberto</bpmn:outgoing><bpmn:outgoing>Flow_GatewayCondicao_TaskConsultarNormal</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConsultarAberto" name="Consultar alerta aberto do tipo"><bpmn:incoming>Flow_GatewayCondicao_TaskConsultarAberto</bpmn:incoming><bpmn:outgoing>Flow_TaskConsultarAberto_GatewayAlertaExiste</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AlertaExiste" name="Alerta aberto?"><bpmn:incoming>Flow_TaskConsultarAberto_GatewayAlertaExiste</bpmn:incoming><bpmn:outgoing>Flow_GatewayAlertaExiste_TaskManter</bpmn:outgoing><bpmn:outgoing>Flow_GatewayAlertaExiste_TaskAbrir</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Manter" name="Preservar alerta sem duplicar"><bpmn:incoming>Flow_GatewayAlertaExiste_TaskManter</bpmn:incoming><bpmn:outgoing>Flow_TaskManter_EndManter</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Manter" name="Alerta preservado"><bpmn:incoming>Flow_TaskManter_EndManter</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_Abrir" name="Abrir ocorrência com restrição única"><bpmn:incoming>Flow_GatewayAlertaExiste_TaskAbrir</bpmn:incoming><bpmn:outgoing>Flow_TaskAbrir_EndAbrir</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ErroAbrir" name="Falha na gravação" attachedToRef="Task_Abrir" cancelActivity="true"><bpmn:outgoing>Flow_BoundaryErroAbrir_TaskRegistrarFalha</bpmn:outgoing><bpmn:errorEventDefinition id="ErrorDef_Boundary_ErroAbrir" errorRef="Error_avaliacao-alertas"/></bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Abrir" name="Alerta aberto"><bpmn:incoming>Flow_TaskAbrir_EndAbrir</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_ConsultarNormal" name="Consultar alerta ainda aberto"><bpmn:incoming>Flow_GatewayCondicao_TaskConsultarNormal</bpmn:incoming><bpmn:outgoing>Flow_TaskConsultarNormal_GatewayResolver</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Resolver" name="Existe alerta aberto?"><bpmn:incoming>Flow_TaskConsultarNormal_GatewayResolver</bpmn:incoming><bpmn:outgoing>Flow_GatewayResolver_TaskResolver</bpmn:outgoing><bpmn:outgoing>Flow_GatewayResolver_TaskNenhumaAcao</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Resolver" name="Registrar resolução automática"><bpmn:incoming>Flow_GatewayResolver_TaskResolver</bpmn:incoming><bpmn:outgoing>Flow_TaskResolver_EndResolvido</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ErroResolver" name="Falha na gravação" attachedToRef="Task_Resolver" cancelActivity="true"><bpmn:outgoing>Flow_BoundaryErroResolver_TaskRegistrarFalha</bpmn:outgoing><bpmn:errorEventDefinition id="ErrorDef_Boundary_ErroResolver" errorRef="Error_avaliacao-alertas"/></bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Resolvido" name="Alerta resolvido"><bpmn:incoming>Flow_TaskResolver_EndResolvido</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_NenhumaAcao" name="Não há alerta a resolver"><bpmn:incoming>Flow_GatewayResolver_TaskNenhumaAcao</bpmn:incoming><bpmn:outgoing>Flow_TaskNenhumaAcao_EndNenhumaAcao</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_NenhumaAcao" name="Sem alteração"><bpmn:incoming>Flow_TaskNenhumaAcao_EndNenhumaAcao</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_RegistrarFalha" name="Registrar falha; não confirmar alteração"><bpmn:incoming>Flow_BoundaryErroAbrir_TaskRegistrarFalha</bpmn:incoming><bpmn:incoming>Flow_BoundaryErroResolver_TaskRegistrarFalha</bpmn:incoming><bpmn:outgoing>Flow_TaskRegistrarFalha_EndErro</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Erro" name="Falha tratada"><bpmn:incoming>Flow_TaskRegistrarFalha_EndErro</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartEvaluate_TaskDeterminarTipo" sourceRef="Start_Evaluate" targetRef="Task_DeterminarTipo"/>
    <bpmn:sequenceFlow id="Flow_TaskDeterminarTipo_GatewayTemDados" sourceRef="Task_DeterminarTipo" targetRef="Gateway_TemDados"/>
    <bpmn:sequenceFlow id="Flow_GatewayTemDados_TaskSemDados" sourceRef="Gateway_TemDados" targetRef="Task_SemDados" name="Não"/>
    <bpmn:sequenceFlow id="Flow_TaskSemDados_EndSemDados" sourceRef="Task_SemDados" targetRef="End_SemDados"/>
    <bpmn:sequenceFlow id="Flow_GatewayTemDados_GatewayCondicao" sourceRef="Gateway_TemDados" targetRef="Gateway_Condicao" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_GatewayCondicao_TaskConsultarAberto" sourceRef="Gateway_Condicao" targetRef="Task_ConsultarAberto" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_TaskConsultarAberto_GatewayAlertaExiste" sourceRef="Task_ConsultarAberto" targetRef="Gateway_AlertaExiste"/>
    <bpmn:sequenceFlow id="Flow_GatewayAlertaExiste_TaskManter" sourceRef="Gateway_AlertaExiste" targetRef="Task_Manter" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_TaskManter_EndManter" sourceRef="Task_Manter" targetRef="End_Manter"/>
    <bpmn:sequenceFlow id="Flow_GatewayAlertaExiste_TaskAbrir" sourceRef="Gateway_AlertaExiste" targetRef="Task_Abrir" name="Não"/>
    <bpmn:sequenceFlow id="Flow_TaskAbrir_EndAbrir" sourceRef="Task_Abrir" targetRef="End_Abrir"/>
    <bpmn:sequenceFlow id="Flow_GatewayCondicao_TaskConsultarNormal" sourceRef="Gateway_Condicao" targetRef="Task_ConsultarNormal" name="Não"/>
    <bpmn:sequenceFlow id="Flow_TaskConsultarNormal_GatewayResolver" sourceRef="Task_ConsultarNormal" targetRef="Gateway_Resolver"/>
    <bpmn:sequenceFlow id="Flow_GatewayResolver_TaskResolver" sourceRef="Gateway_Resolver" targetRef="Task_Resolver" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_TaskResolver_EndResolvido" sourceRef="Task_Resolver" targetRef="End_Resolvido"/>
    <bpmn:sequenceFlow id="Flow_GatewayResolver_TaskNenhumaAcao" sourceRef="Gateway_Resolver" targetRef="Task_NenhumaAcao" name="Não"/>
    <bpmn:sequenceFlow id="Flow_TaskNenhumaAcao_EndNenhumaAcao" sourceRef="Task_NenhumaAcao" targetRef="End_NenhumaAcao"/>
    <bpmn:sequenceFlow id="Flow_BoundaryErroAbrir_TaskRegistrarFalha" sourceRef="Boundary_ErroAbrir" targetRef="Task_RegistrarFalha"/>
    <bpmn:sequenceFlow id="Flow_BoundaryErroResolver_TaskRegistrarFalha" sourceRef="Boundary_ErroResolver" targetRef="Task_RegistrarFalha"/>
    <bpmn:sequenceFlow id="Flow_TaskRegistrarFalha_EndErro" sourceRef="Task_RegistrarFalha" targetRef="End_Erro"/>
  </bpmn:process>
